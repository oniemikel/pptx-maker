*.pptx.tmp

# --- Environment Variables (CRITICAL) ---
# セキュリティのため、これらは絶対にコミットしない
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak

# --- Infrastructure (Vercel / Firebase) ---
.vercel/
# Firebaseは廃止方針ですが、残っているキャッシュがあれば除外
.firebase/
firebase-debug.log*

# --- PPTX Maker Specific ---
# もしローカルテストで生成されたpptxをルートに置くなら除外
*.pptx
!src/features/shared/assets/*.pptx  # テンプレート等、意図的なものは許可